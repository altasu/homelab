# Grafana — variables d'environnement pour l'unité Quadlet
# Copier : cp grafana.env.example grafana.env  (jamais committer grafana.env !)
# Valeurs finales, sans quotes, sans échappement $$ — valider avec
# scripts/check-env.sh.

# Mot de passe de l'administrateur (à stocker dans le gestionnaire de mots de passe)
GF_SECURITY_ADMIN_PASSWORD=your_strong_admin_password

# Durcissement : pas d'inscription libre, pas d'accès anonyme
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# Confidentialité : aucune télémétrie ni appel sortant vers l'éditeur
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# Jeton d'accès ntfy, référencé par le point de contact provisionné
# (apps/monitoring/grafana/alerting/contact-points.yml).
# Générer côté ntfy : podman exec ntfy ntfy token add <utilisateur>
NTFY_TOKEN=your_ntfy_access_token
