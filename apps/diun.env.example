# Diun — variables d'environnement pour l'unité Quadlet
# Copier : cp diun.env.example diun.env  (jamais committer diun.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Fuseau horaire du conteneur et niveau de journalisation
TZ=Europe/Paris
LOG_LEVEL=info
LOG_JSON=false

# Fréquence d'analyse planifiée (toutes les 6 heures à la minute 0)
DIUN_WATCH_SCHEDULE=0 */6 * * *
DIUN_WATCH_WORKERS=10
DIUN_WATCH_JITTER=30s

# Fournisseur Docker/Podman via socket rootless
DIUN_PROVIDERS_DOCKER=true
DIUN_PROVIDERS_DOCKER_ENDPOINT=unix:///var/run/docker.sock
DIUN_PROVIDERS_DOCKER_WATCHBYDEFAULT=true
DIUN_PROVIDERS_DOCKER_WATCHSTOPPED=false

# Persistance de la base de données interne (mémorisation des manifestes)
DIUN_DB_PATH=/data/diun.db

# Notifications push ntfy vers l'instance auto-hébergée
DIUN_NOTIF_NTFY_ENDPOINT=http://ntfy:80
DIUN_NOTIF_NTFY_TOPIC=homelab
DIUN_NOTIF_NTFY_PRIORITY=3
DIUN_NOTIF_NTFY_TAGS=package,whale
