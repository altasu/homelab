# Forgejo — variables d'environnement pour l'unité Quadlet
# Copier : cp forgejo.env.example forgejo.env (jamais committer forgejo.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Configuration générale
USER_UID=1000
USER_GID=1000

# Base de données : SQLite autonome dans le volume apps_forgejo_data
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/var/lib/gitea/data/gitea.db

# Configuration du serveur
FORGEJO__server__ROOT_URL=https://git.your_domain_placeholder.com/
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__DOMAIN=git.your_domain_placeholder.com
FORGEJO__server__SSH_PORT=2222

# Sécurité & Inscription
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
