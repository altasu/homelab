# Unité Quadlet : prometheus-podman-exporter (métriques des conteneurs)
# Étape 7 du plan — observabilité.
#
# Choisi À LA PLACE de cAdvisor : en rootless, cAdvisor accède mal aux
# cgroups et consomme beaucoup de CPU. Cet exportateur interroge simplement
# le socket Podman utilisateur — bien plus léger et adapté au mode rootless.
#
# PRÉREQUIS : socket Podman utilisateur actif
#   systemctl --user enable --now podman.socket
#
# Image publiée uniquement sur quay.io (pas de miroir docker.io) : référence
# pleinement qualifiée, conforme à l'esprit de la règle sur les images.

[Unit]
Description=prometheus-podman-exporter (metriques des conteneurs)
Requires=podman.socket
After=podman.socket

[Container]
ContainerName=podman-exporter
Image=quay.io/navidys/prometheus-podman-exporter:v1.21.2
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Network=homelab.network
PodmanArgs=--userns=keep-id:uid=65534 --security-opt label=type:container_runtime_t --memory=128m --cpus=0.25

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
