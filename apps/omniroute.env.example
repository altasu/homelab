# OmniRoute — variables d'environnement pour l'unité Quadlet
# Copier : cp omniroute.env.example omniroute.env (jamais committer omniroute.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Configuration réseau et stockage
PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/app/data

# Mot de passe administrateur initial pour le tableau de bord (obligatoire pour sécuriser l'accès)
INITIAL_PASSWORD=your_strong_admin_password_here

# Clé de chiffrement AES pour les clés API stockées en base SQLite (générer via : openssl rand -hex 32)
STORAGE_ENCRYPTION_KEY=your_32byte_hex_encryption_key_here

# Clé secrète pour la signature des sessions JWT du tableau de bord (générer via : openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here

# Clé secrète interne pour les clés API OmniRoute (générer via : openssl rand -hex 32)
API_KEY_SECRET=your_api_key_secret_here
