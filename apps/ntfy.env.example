# ntfy — variables d'environnement pour l'unité Quadlet
# Copier : cp ntfy.env.example ntfy.env  (jamais committer ntfy.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# URL externe réelle du service (jamais versionnée : nom de domaine réel)
NTFY_BASE_URL=https://your_ntfy_public_url

# Sécurité : serveur fermé par défaut. Sans cela, un service exposé
# publiquement devient un relais de notifications ouvert à tous.
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# Persistance
NTFY_CACHE_FILE=/var/lib/ntfy/cache.db
NTFY_AUTH_FILE=/var/lib/ntfy/auth.db
NTFY_ATTACHMENT_CACHE_DIR=/var/lib/ntfy/attachments

# Service placé derrière un tunnel / reverse proxy
NTFY_BEHIND_PROXY=true

# --- Optionnel : livraison push sur iOS ---
# Les appareils iOS ne peuvent pas recevoir de push d'un serveur
# auto-hébergé sans relais. Décommenter pour qu'un simple signal de
# réveil transite par le service public — le contenu des messages, lui,
# reste sur ce serveur.
# NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
