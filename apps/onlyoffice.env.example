# ONLYOFFICE Document Server — variables d'environnement pour l'unité Quadlet
# Copier : cp onlyoffice.env.example onlyoffice.env  (jamais committer onlyoffice.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Sécurité des jetons JWT (protection contre les falsifications de documents)
JWT_ENABLED=true
JWT_SECRET=your_long_secure_jwt_secret_here
JWT_HEADER=Authorization
JWT_IN_BODY=true

# Autorisation de communication interne avec le stockage Nextcloud
USE_UNAUTHORIZED_STORAGE=true
