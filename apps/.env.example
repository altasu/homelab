# Stage 3: Applications — Variables d'environnement
# Copiez ce fichier: cp .env.example .env
# Ne jamais committer le fichier .env !

# --- Vaultwarden ---
# Générer un token chiffré Argon2id pour la page d'administration :
# podman run --rm -it docker.io/vaultwarden/server:1.36.0-alpine /vaultwarden hash
# Remplacer par la chaîne générée commençant par $argon2id$...
VAULTWARDEN_ADMIN_TOKEN=your_secure_argon2_phc_format_token


# --- PostgreSQL (Connexion de Vaultwarden) ---
# Ces valeurs doivent correspondre à celles définies dans data/.env
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=your_postgres_db

