# Stage 3: Applications — Variables d'environnement
# Copiez ce fichier: cp .env.example .env
# Ne jamais committer le fichier .env !

# --- Vaultwarden ---
# Générer un token sécurisé: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=your_secure_admin_token_here

# Nom de la base de données Vaultwarden dans PostgreSQL
VAULTWARDEN_DB_NAME=your_vaultwarden_db_name

# --- PostgreSQL (doit correspondre à data/.env) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password
