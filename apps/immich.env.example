# Variables d'environnement pour la pile Immich (Serveur, ML, PostgreSQL)
# Copier : cp immich.env.example immich.env (ne jamais committer immich.env avec des secrets réels !)
# Valeurs finales attendues par Podman (sans quotes, sans espaces superflus).

TZ=Europe/Paris

# --- Configuration de la Base de Données Dédiée (PostgreSQL VectorChord) ---
DB_HOSTNAME=immich-postgres
DB_USERNAME=postgres
DB_PASSWORD=your_secure_immich_db_password_here
DB_DATABASE_NAME=immich

# Variables injectées dans l'unité immich-postgres.container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_immich_db_password_here
POSTGRES_DB=immich
POSTGRES_INITDB_ARGS=--data-checksums

# --- Cache et File d'Attente Valkey / Redis ---
REDIS_HOSTNAME=immich-redis

# --- Service d'Apprentissage Automatique (Machine Learning) ---
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# --- Emplacement Interne des Données (Point de montage dans le conteneur) ---
UPLOAD_LOCATION=/data
