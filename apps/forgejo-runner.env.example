# Configuration pour Forgejo Runner
# Copier ce fichier : cp forgejo-runner.env.example forgejo-runner.env
# Remplacer la valeur de FORGEJO_TOKEN par le jeton généré dans l'interface web.

FORGEJO_URL=http://forgejo:3000
FORGEJO_TOKEN=votre_jeton_secret_ici
FORGEJO_RUNNER_NAME=homelab-runner
FORGEJO_RUNNER_LABELS=docker:docker://node:20-bookworm-slim,ubuntu-latest:docker://node:20-bookworm-slim,ubuntu-22.04:docker://node:20-bookworm-slim
