# Wakapi — variables d'environnement pour l'unité Quadlet
# Copier : cp wakapi.env.example wakapi.env  (jamais committer wakapi.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Sel cryptographique pour le hachage des mots de passe (chaîne aléatoire d'au moins 32 caractères)
# Générer via : openssl rand -hex 32
WAKAPI_PASSWORD_SALT=your_random_password_salt_min_32_chars

# Configuration du serveur HTTP interne
WAKAPI_LISTEN_IPV4=0.0.0.0
WAKAPI_PORT=3000

# Base de données SQLite embarquée (zéro empreinte mémoire)
WAKAPI_DB_TYPE=sqlite3
WAKAPI_DB_NAME=/data/wakapi.db

# URL publique externe (utilisée pour les liens, badges et l'API client)
WAKAPI_PUBLIC_URL=https://your_wakapi_public_url

# Inscription : activer (true) lors du premier démarrage pour créer le compte administrateur,
# puis basculer impérativement sur false pour fermer le serveur aux inscriptions publiques.
WAKAPI_ALLOW_SIGNUP=true

# Sécurité des cookies : false si le trafic HTTPS est géré en amont par le reverse proxy / Cloudflare Tunnel
WAKAPI_INSECURE_COOKIES=false
