# Linkding — variables d'environnement pour l'unité Quadlet
# Copier : cp linkding.env.example linkding.env (ne jamais committer linkding.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère # dans les valeurs
# — valider avec scripts/check-env.sh.

TZ=Europe/Paris

# Compte super-administrateur initial (créé automatiquement au premier démarrage)
LD_SUPERUSER_NAME=admin
LD_SUPERUSER_PASSWORD=ChangeMe_StrongPasswordHere123!

# Sécurité & Inscription (désactiver les inscriptions publiques)
LD_DISABLE_REGISTRATION=True

# Reverse Proxy & Domaines de confiance (Cloudflare Tunnel / Twingate)
# Renseigner l'URL complète avec schéma (https://) sans slash final
LD_CSRF_TRUSTED_ORIGINS=https://bookmarks.votre-domaine.com
LD_USE_X_FORWARDED_HOST=True
LD_USE_X_FORWARDED_PORT=True
