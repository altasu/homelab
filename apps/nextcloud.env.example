# Nextcloud — variables d'environnement pour l'unité Quadlet
# Copier : cp nextcloud.env.example nextcloud.env  (jamais committer nextcloud.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Fuseau horaire du conteneur
TZ=Europe/Paris

# Base de données PostgreSQL (Data Tier centralisé postgres-db:5432)
POSTGRES_HOST=postgres-db:5432
POSTGRES_DB=nextcloud_db
POSTGRES_USER=nextcloud_user
POSTGRES_PASSWORD=your_nextcloud_postgres_password_here

# Cache mémoire et verrous transactionnels Redis
REDIS_HOST=nextcloud-redis
REDIS_HOST_PORT=6379

# Compte administrateur initial (créé lors du premier lancement)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_secure_admin_password_here

# Domaines de confiance (FQDN distant, IP locale du serveur, nom DNS interne)
NEXTCLOUD_TRUSTED_DOMAINS=cloud.your-domain.com 192.168.x.x nextcloud

# Configuration du reverse proxy (Cloudflare Tunnel & Twingate)
TRUSTED_PROXIES=10.89.0.0/16 127.0.0.1
OVERWRITECLIURL=https://cloud.your-domain.com
OVERWRITEPROTOCOL=https
OVERWRITEHOST=cloud.your-domain.com

# Optimisation Apache et mise à jour
APACHE_DISABLE_REWRITE_IP=1
