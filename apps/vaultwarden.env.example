# Vaultwarden — variables d'environnement pour l'unité Quadlet
# Copier : cp vaultwarden.env.example vaultwarden.env  (jamais committer vaultwarden.env !)
# Contrairement aux .env compose, ce fichier contient les variables FINALES
# attendues par le conteneur (EnvironmentFile= les passe telles quelles).

# Jeton Argon2 PHC de la page d'administration (générer avec :
# podman run --rm -it docker.io/vaultwarden/server:<version> /vaultwarden hash)
ADMIN_TOKEN=your_secure_argon2_phc_format_token

# URL complète de connexion PostgreSQL (mêmes valeurs que data/.env).
# Rappel : caractères spéciaux du mot de passe à encoder en percent-encoding.
DATABASE_URL=postgresql://your_db_user:your_secure_db_password@postgres-db:5432/your_postgres_db

SIGNUPS_ALLOWED=false
WEBSOCKET_ENABLED=true
