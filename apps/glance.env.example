# Variables d'environnement pour l'unité Quadlet Glance
# Copier : cp glance.env.example glance.env
# Ne jamais committer glance.env avec des valeurs de production !

TZ=Europe/Paris

# --- Liens Applicatifs (Bookmarks) ---
# Renseigner les URLs complètes selon votre méthode d'accès (Cloudflare Tunnel ou Twingate)
URL_VAULTWARDEN=https://vaultwarden.votre-domaine.com
URL_ACTUAL_BUDGET=https://budget.votre-domaine.com
URL_FORGEJO=https://git.votre-domaine.com
URL_COCKPIT=https://192.168.x.x:9090
URL_GRAFANA=https://grafana.votre-domaine.com
URL_PROMETHEUS=http://prometheus:9090
URL_NTFY=https://ntfy.votre-domaine.com
URL_LINKDING=https://bookmarks.votre-domaine.com
