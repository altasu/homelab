# Variables d'environnement pour l'unité Quadlet Collabora Online (CODE)
# Copier : cp apps/collabora.env.example apps/collabora.env
# Ne jamais committer collabora.env avec des secrets réels !
# Valider avec : bash scripts/check-env.sh apps/collabora.env

# Nom de domaine public complet de Collabora (sans protocole)
server_name=office.votre-domaine.com

# URL du client Nextcloud autorisé à communiquer en WOPI (échapper les points avec \\.)
# Exemple : https://cloud\\.votre-domaine\\.com:443
aliasgroup1=https://cloud\\.votre-domaine\\.com:443

# Identifiants de la console d'administration (/browser/dist/admin/admin.html)
username=admin
password=votre_mot_de_passe_robuste_ici

# Paramètres Collabora pour terminaison SSL externe et compatibilité Podman rootless (désactivation du montage jail)
extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:mount_jail_tree=false
