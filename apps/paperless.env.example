# Paperless-ngx — Variables d'environnement pour l'unité Quadlet (apps/)
# Copier : cp apps/paperless.env.example apps/paperless.env (ne jamais committer paperless.env !)
# Format : valeurs brutes, sans quotes, sans échappement $$, sans caractère # dans les valeurs
# Validation : scripts/check-env.sh apps/paperless.env.example

# Paramètres généraux & Localisation
USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_URL=https://docs.votre-domaine.com

# Clé secrète Django (Générer une clé aléatoire via : openssl rand -hex 32)
PAPERLESS_SECRET_KEY=ChangeMe_GenerateWith_openssl_rand_hex_32

# Cache & File d'attente (Redis dédié sur le réseau homelab.network)
PAPERLESS_REDIS=redis://paperless-redis:6379

# Base de données PostgreSQL (Tier Data centralisé - postgres-db)
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=postgres-db
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless_db
PAPERLESS_DBUSER=paperless_user
PAPERLESS_DBPASS=ChangeMe_StrongPostgresPasswordHere123!

# Moteur OCR (Tesseract) & Détection multilingue
PAPERLESS_OCR_LANGUAGE=fra
PAPERLESS_OCR_LANGUAGES=fra tur eng
PAPERLESS_OCR_CLEAN=clean

# Confinement des workers pour processeur hôte (Intel Core i7-6500U)
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_WEBSERVER_WORKERS=1

# Compte administrateur initial (créé automatiquement au premier démarrage si absent)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=ChangeMe_AdminPassword123!
PAPERLESS_ADMIN_MAIL=admin@votre-domaine.com
