# Windows 11 — variables d'environnement pour l'unité Quadlet
# Copier : cp windows.env.example windows.env (jamais committer windows.env !)
# Valeurs finales, sans quotes, sans échappement $$, sans caractère #
# — valider avec scripts/check-env.sh.

# Version de Windows a installer (win11, 11, win10, 10, tiny11)
VERSION=win11

# Allocation de memoire vive pour la VM (ex: 4G, 6G, 8G)
RAM_SIZE=4G

# Nombre de coeurs processeur alloues a la VM
CPU_CORES=2

# Taille du disque dur virtuel persistant
DISK_SIZE=64G

# Identifiants de session Windows et RDP
USERNAME=homelab
PASSWORD=your_secure_windows_password_here

# Langue du systeme et disposition du clavier
LANGUAGE=English
KEYBOARD=en-US

# Configuration reseau
DHCP=Y
