# Twingate Connector — variables d'environnement pour l'unité Quadlet
# Copier : cp twingate.env.example twingate.env  (jamais committer twingate.env !)
# Mêmes noms de variables que l'ancien infra/.env (déjà les noms finals).
# Sans quotes, sans échappement $$ — valider avec scripts/check-env.sh.

TWINGATE_NETWORK=your_twingate_network_name
TWINGATE_ACCESS_TOKEN=your_twingate_access_token
TWINGATE_REFRESH_TOKEN=your_twingate_refresh_token
