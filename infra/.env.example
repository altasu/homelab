# Stage 1: Core Infra — Variables d'environnement
# Copiez ce fichier: cp .env.example .env
# Ne jamais committer le fichier .env !

# --- Cloudflare Tunnel ---
CLOUDFLARE_TOKEN=your_cloudflare_token

# --- Twingate Connector ---
TWINGATE_NETWORK=your_twingate_network_name
TWINGATE_ACCESS_TOKEN=your_twingate_access_token
TWINGATE_REFRESH_TOKEN=your_twingate_refresh_token
