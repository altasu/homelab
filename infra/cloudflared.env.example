# Cloudflare Tunnel — variables d'environnement pour l'unité Quadlet
# Copier : cp cloudflared.env.example cloudflared.env  (jamais committer cloudflared.env !)
# Valeur finale attendue par le conteneur : TUNNEL_TOKEN
# (= la valeur de CLOUDFLARE_TOKEN dans l'ancien infra/.env — compose
# faisait le renommage, ici la variable porte directement son nom final).
# Sans quotes, sans échappement $$ — valider avec scripts/check-env.sh.

TUNNEL_TOKEN=your_cloudflare_tunnel_token
