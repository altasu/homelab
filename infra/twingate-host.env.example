# Twingate Connector (Host) — variables d'environnement pour l'unité Quadlet
# Copier : cp twingate-host.env.example twingate-host.env
# Attention: Ne jamais committer twingate-host.env !
# Ce connecteur fonctionne sur le réseau de l'hôte (Network=host) pour 
# fournir un accès VPN aux services physiques comme Cockpit ou le LAN.

TWINGATE_NETWORK=your_twingate_network_name
TWINGATE_ACCESS_TOKEN=your_twingate_access_token
TWINGATE_REFRESH_TOKEN=your_twingate_refresh_token
