# PostgreSQL — variables d'environnement pour l'unité Quadlet
# Copier : cp postgres.env.example postgres.env  (jamais committer postgres.env !)
# Reprendre les MÊMES valeurs que data/.env (source actuelle de compose).
# BACKUP_DIR reste dans data/.env : il appartient à scripts/backup.sh,
# pas au conteneur.
#
# ATTENTION : valeurs BRUTES ici (pas de percent-encoding — celui-ci ne
# concerne que la DATABASE_URL de apps/vaultwarden.env), sans quotes,
# sans échappement $$ (voir scripts/check-env.sh).

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=your_postgres_db
