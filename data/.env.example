# Stage 2: Data — Variables d'environnement
# Copiez ce fichier: cp .env.example .env
# Ne jamais committer le fichier .env !

# --- PostgreSQL (Configuration Globale) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password

# --- Configuration des Sauvegardes (Automated Backups) ---
# Chemin absolu vers le disque externe (HDD)
# OBLIGATOIRE pour le fonctionnement de scripts/backup.sh
BACKUP_DIR=/path/to/your/external/hdd/backups
