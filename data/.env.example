# Stage 2: Data — Variables d'environnement
# Copiez ce fichier: cp .env.example .env
# Ne jamais committer le fichier .env !

# --- PostgreSQL (Configuration Globale) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_db_password

# Chemin absolu sur l'hôte pour la persistance des données
POSTGRES_DATA_PATH=/path/to/your/postgres/data
