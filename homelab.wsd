@startuml
skinparam componentStyle rectangle
skinparam backgroundColor #F9F9F9
skinparam packageBackgroundColor #FFFFFF

actor "Utilisateur / User" as user
cloud "Internet / Zero Trust" as internet

package "Serveur Homelab" {
    
    [Réseau Partagé / Shared Network\n(homelab_net)] as shared_net #LightBlue
    
    package "Stage 1: Core Infra (Actif/Active)\n(infra/)" {
        [Twingate Connector] as twingate #LightGreen
        [Cloudflare Tunnel] as cloudflare #LightGreen
    }

    package "Stage 2: Data\n(data/)" #White {
        note "À venir / Coming soon" as n1
    }

    package "Stage 3: Apps\n(apps/)" #White {
        note "À venir / Coming soon" as n2
    }
}

user =down=> internet
internet ==down==> twingate : "Accès Sécurisé / Secure Access"
internet -.down.-> cloudflare : "Trafic Web / Web Traffic"

twingate ==down==> shared_net
cloudflare ==down==> shared_net

@enduml