@startuml homelab
skinparam componentStyle rectangle
skinparam backgroundColor #F9F9F9
skinparam packageBackgroundColor #FFFFFF
skinparam linetype ortho

actor "Utilisateur / User" as user
cloud "Cloudflare\n(CDN + Zero Trust)" as cloudflare_cdn
cloud "Twingate\n(Zero Trust Network)" as twingate_cloud

package "Serveur Homelab" {

    package "Stage 1: Core Infra (infra/)\n[NE JAMAIS ARRÊTER]" #LightYellow {
        [cloudflared\n:2026.5.2] as cloudflared
        [twingate-connector\n:1] as twingate
    }

    package "Stage 2: Data (data/)\n[LE PLUS CRITIQUE]" #LightCoral {
        database "PostgreSQL\n(Stockage Externe / External Storage)" as postgres
    }

    package "Stage 3: Apps (apps/)" #LightGreen {
        [Vaultwarden\n:latest] as vaultwarden
        [Homepage *(futur)*] as homepage
        [Glance *(futur)*] as glance
    }

    [Réseau Partagé\nhomelab_net] as net #LightBlue
}

' Accès Zero Trust
user --> cloudflare_cdn : "HTTPS\nvault.yourdomain.com"
user --> twingate_cloud : "VPN Zero Trust\n(Cockpit, SSH)"

' Connexions sortantes (outbound only)
cloudflared --> cloudflare_cdn : "Tunnel sortant\n(outbound)"
twingate --> twingate_cloud : "Tunnel sortant\n(outbound)"

' Réseau interne partagé
cloudflared --> net
twingate --> net
postgres --> net
vaultwarden --> net

' Routing applicatif via homelab_net
cloudflared ..> vaultwarden : "http://vaultwarden:80\n(container name)"
vaultwarden ..> postgres : "postgresql://\npostgres-db:5432"

@enduml